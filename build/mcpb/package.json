{
  "name": "shellphone",
  "version": "0.1.0",
  "description": "A context bridge between Claude Code and Claude Chat. Lobster Telephone, but for two Claudes.",
  "type": "module",
  "bin": {
    "shellphone": "dist/cli.js"
  },
  "files": [
    "dist",
    "manifest.json",
    "icon.png",
    "README.md",
    "PRIVACY.md",
    "SPEC.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "prepare": "npm run build",
    "test": "node --test test/*.test.js",
    "pack": "bash scripts/pack-mcpb.sh"
  },
  "keywords": [
    "mcp",
    "claude",
    "claude-code",
    "model-context-protocol"
  ],
  "license": "MIT",
  "dependencies": {
