    "express": "^5.2.1",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.2",
    "typescript": "5.9"
  },
  "author": "Geoffrey Taghon <geoff.taghon@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gtaghon1/shellphone.git"
  },
  "homepage": "https://github.com/gtaghon1/shellphone#readme",
  "bugs": {
    "url": "https://github.com/gtaghon1/shellphone/issues"
